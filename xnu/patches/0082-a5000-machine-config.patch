 # Headers installed into System.framework/PrivateHeaders (userspace internal SDK only).
diff --git a/pexpert/pexpert/arm64/A5000.h b/pexpert/pexpert/arm64/A5000.h
new file mode 100644
--- /dev/null
+++ b/pexpert/pexpert/arm64/A5000.h
@@ -0,0 +1,16 @@
+/*
+ * OnePlus 5 (A5000 / MSM8998) target. The existing Sweet source patches
+ * provide the first-stage GICv3, Group 1 IRQ, PSCI, timer and generic iOS
+ * services; board-specific drivers still require A5000 validation.
+ */
+#ifndef _PEXPERT_ARM64_A5000_H
+#define _PEXPERT_ARM64_A5000_H
+
+/* Reuse the current Qualcomm non-secure GICv3 and PSCI code paths. */
+#include <pexpert/arm64/SWEET.h>
+#define A5000                     1
+
+/* Kryo 280 is ARMv8-A; do not advertise v8.1 PAN without hardware proof. */
+#undef __ARM_PAN_AVAILABLE__
+
+#endif /* _PEXPERT_ARM64_A5000_H */
diff --git a/iokit/Kernel/arm/SweetCPU.cpp b/iokit/Kernel/arm/SweetCPU.cpp
--- a/iokit/Kernel/arm/SweetCPU.cpp
+++ b/iokit/Kernel/arm/SweetCPU.cpp
@@ -78,9 +78,15 @@ SweetCPU::start(IOService *provider)
 	if (*(const uint32_t *)reg->getBytesNoCopy() != cpu->phys_id) {
 		return false;
 	}
+#if defined(A5000)
+	const bool valid_mpidr = cpu->phys_id <= 3 ||
+	    (cpu->phys_id >= 0x100 && cpu->phys_id <= 0x103);
+	if (!valid_mpidr || topology->num_cpus > SWEET_SMP_MAX_CPUS) {
+#else
 	/* MPIDR Aff1 = core: 0x000-0x500 A55, 0x600/0x700 A76 */
 	if (cpu->phys_id > 0x700 || (cpu->phys_id & 0xff) != 0 ||
 	    topology->num_cpus > SWEET_SMP_MAX_CPUS) {
+#endif
 		panic("SWEET CPU: invalid topology cpu=%u mpidr=0x%x count=%u",
 		    cpu->cpu_id, cpu->phys_id, topology->num_cpus);
 	}
@@ -103,6 +108,10 @@ SweetCPU::start(IOService *provider)
 		return false;
 	}
+#if defined(A5000)
+	cpuName = OSSymbol::withCStringNoCopy("Kryo 280");
+#else
 	cpuName = OSSymbol::withCStringNoCopy("Kryo 470");
+#endif
 	if (cpuName == NULL) {
 		return false;
 	}
